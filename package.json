{
  "name": "edge-rate-limiter",
  "version": "0.1.0",
  "description": "Zero-dependency sliding-window and token bucket rate limiter for Edge, Cloudflare Workers, and Node.js with Zero-PII anonymization.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_JA.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "token-bucket",
    "sliding-window",
    "edge",
    "cloudflare-workers",
    "zero-pii",
    "security",
    "zero-dependencies"
  ],
  "author": "takao-dev",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
